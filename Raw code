    if(FORM_URL.indexOf("PASTE_WEB_APP_URL") > -1){ toast.textContent = "Sheet link not set yet"; return; }
    if(v.length > 1500){ toast.textContent = "Too long (max 1500 characters)"; return; }
    var btn = document.getElementById("reqSubmit");
    btn.disabled = true; toast.textContent = "Sending...";
    var cb = "reqCb" + Date.now(), sc = document.createElement("script"), finished = false;
    function finish(msg, good){
      if(finished) return; finished = true;
      btn.disabled = false; toast.textContent = msg;
      try{ delete window[cb]; }catch(e){ window[cb] = undefined; }
      sc.remove();
      if(good){ t.value = ""; setTimeout(close, 1500); }
    }
    window[cb] = function(r){
      if(r && r.ok) finish("Submit successfully ✓", true);
      else finish("Sheet script error: " + ((r && r.error) || "unknown"), false);
    };
    sc.onerror = function(){ finish("Could not reach the sheet script. Check the web app URL and access.", false); };
    sc.src = FORM_URL + (FORM_URL.indexOf("?") > -1 ? "&" : "?") + "callback=" + cb + "&text=" + encodeURIComponent(v);
    document.body.appendChild(sc);
    setTimeout(function(){ finish("No reply from the script. Check the sheet, and redeploy the script.", false); }, 15000);
  };
})();
