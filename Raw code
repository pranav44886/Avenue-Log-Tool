}
function findTime(text){
  const m = text.match(TIME_RE); if(!m) return null;
  let h = Number(m[1]);
  if(m[3]){ h = h % 12; if(m[3].toUpperCase()==="P") h += 12; }
  return { v: String(h).padStart(2,"0") + ":" + m[2], fmt: m[3] ? "12" : "24" };
}
function parseTags(text){
  const t = stripStamp(text).replace(/\.(?=[A-Z])/g,"").replace(/(\d{5,6})(?=[A-Z])/g,"$1 ");
  const out = [];
  t.split(/[\/\s,;|]+/).forEach(x=>{ x = x.trim(); if(x && !out.includes(x)) out.push(x); });
  return out;
}
function prefixOf(tag){
  const m = tag.match(/^([A-Z]+?)(?:EXT|INT)/);
  if(!m) return null;
  return m[1];
}
function siteOf(tag){
  const p = prefixOf(tag); if(!p) return null;
  if(p==="RDP"){ const c = tag[3]; return SITES["RDP"+c] ? "RDP"+c : null; }
  if(p==="APP"){ const c = tag[3]; return SITES["APP"+c] ? "APP"+c : null; }
  if(p==="RDPE"||p==="RDPW"||p==="RDPN") return p;
  return SITES[p] ? p : null;
}
const PLAIN_TAGS = { side1:"WVR", side2:"WVR", front:"WVR" };
function siteOfAny(tag){
  if(PLAIN_TAGS[tag.toLowerCase()]) return PLAIN_TAGS[tag.toLowerCase()];
  // RDPEEXT... -> prefix regex gives "RDPE"; APPAEXT -> "APPA"
  const p = prefixOf(tag);
  if(p==="GLM" && tag.endsWith("000463")) return "ELT";
  if(p==="GLM") return tag.includes("LBBYB") ? "GLMB" : "GLMA";
  return p && SITES[p] ? p : null;
}
function tagString(){ return parseTags($("cam").value).join("/"); }

function renderProp(){
  const props = [];
  parseTags($("cam").value).forEach(t=>{
    const k = siteOfAny(t); if(k && !props.includes(SITES[k])) props.push(SITES[k]);
  });
  $("prop").textContent = props.length ? "Property: " + props.join(", ") : "";
}
function renderTabs(){
  $("tabs").innerHTML = "";
  Object.keys(EVENTS).forEach(t=>{
    const b = document.createElement("button");
    b.className = "tab" + (t===tab?" sel":"");
    b.textContent = t;
    b.onclick = () => { tab = t; renderTabs(); renderEvs(); };
    $("tabs").appendChild(b);
  });
}
function renderEvs(){
  $("evs").innerHTML = "";
  EVENTS[tab].forEach(e=>{
    const b = document.createElement("button");
    b.className = "ev" + (e===ev?" sel":"");
    b.textContent = e.replace(/ @$/,"");
    b.onclick = () => { ev = e; renderEvs(); update(true); };
    $("evs").appendChild(b);
  });
}
function fmtTime(v){
  let h,m;
  if(v){ [h,m] = v.split(":").map(Number); }
  else { const d = new Date(); h = d.getHours(); m = d.getMinutes(); }
  if(timeFmt==="24") return String(h).padStart(2,"0") + ":" + String(m).padStart(2,"0");
  const ap = h>=12 ? "pm" : "am";
  h = h%12 || 12;
  return h + ":" + String(m).padStart(2,"0") + ap;
}
function line(){
  if(!ev) return "";
  const tags = parseTags($("cam").value);
  const groups = [];
  tags.forEach(t=>{
    const k = siteOfAny(t);
    let g = groups.find(x=>x.k===k);
    if(!g){ g = {k, tags:[]}; groups.push(g); }
    g.tags.push(t);
  });
  let head;
  if(groups.length && groups.every(g=>g.k)){
    head = groups.map(g=>g.tags.join("/") + "-" + SITES[g.k] + "-" + ADDR[g.k]).join(" / ");
  } else if(groups.length){
    // some tags unknown: keep what was pasted, add property if the dropdown is set
    head = tags.join("/");
    if(siteFilter) head += "-" + SITES[siteFilter] + "-" + ADDR[siteFilter];
  } else if(siteFilter){
    head = SITES[siteFilter] + "-" + ADDR[siteFilter];
  } else head = "";
  const body = ev.replace(/ @$/,"");
  return (head ? head + "-" : "") + body + " @ " + fmtTime($("time").value);
}
function update(fromClick){
  renderProp();
  const s = line();
  $("out").textContent = s;
  if(fromClick && s && $("autoCopy").checked && ev && (tagString()||siteFilter)) doCopy();
}
async function copyText(s){
  try{ await navigator.clipboard.writeText(s); }
  catch(e){
    const t = document.createElement("textarea"); t.value = s; document.body.appendChild(t);
    t.select(); document.execCommand("copy"); t.remove();
  }
  $("toast").textContent = "Copied ✓"; setTimeout(()=>$("toast").textContent="",1500);
}
async function doCopy(){
  const s = line(); if(!s) return;
  await copyText(s);
  history.unshift(s); history = [...new Set(history)].slice(0,10); renderHist();
}
function renderHist(){
  $("hist").innerHTML = "";
  history.forEach(h=>{
    const d = document.createElement("div"); d.textContent = h;
    d.onclick = () => copyText(h);
    $("hist").appendChild(d);
  });
}
let timeFromPaste = false;
function syncPasted(){
  const tm = findTime($("cam").value);
  if(tm){ $("time").value = tm.v; timeFmt = tm.fmt; timeFromPaste = true; }
  else if(timeFromPaste){ $("time").value = ""; timeFmt = "12"; timeFromPaste = false; }
}
$("cam").addEventListener("input", ()=>{ syncPasted(); update(false); });
$("cam").addEventListener("paste", ()=>setTimeout(()=>{ syncPasted(); update(true); },0));
$("time").addEventListener("input", ()=>update(false));
$("now").onclick = () => { const d=new Date(); $("time").value = String(d.getHours()).padStart(2,"0")+":"+String(d.getMinutes()).padStart(2,"0"); update(false); };
$("copy").onclick = doCopy;
$("clear").onclick = () => { $("cam").value=""; $("time").value=""; timeFromPaste=false; timeFmt="12"; ev=""; renderEvs(); update(false); };
renderTabs(); renderEvs(); update(false);
</script>
