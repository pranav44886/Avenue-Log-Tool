(function(){
  const H = 4526395573415718;
  const hash=(str,seed=0)=>{let h1=0xdeadbeef^seed,h2=0x41c6ce57^seed;for(let i=0,ch;i<str.length;i++){ch=str.charCodeAt(i);h1=Math.imul(h1^ch,2654435761);h2=Math.imul(h2^ch,1597334677);}h1=Math.imul(h1^(h1>>>16),2246822507)^Math.imul(h2^(h2>>>13),3266489909);h2=Math.imul(h2^(h2>>>16),2246822507)^Math.imul(h1^(h1>>>13),3266489909);return 4294967296*(2097151&h2)+(h1>>>0);};
  const lock=document.getElementById("lock"), pw=document.getElementById("pw"), err=document.getElementById("pwErr");
  function tryUnlock(){
    if(hash(pw.value)===H){ document.body.classList.remove("locked"); lock.style.display="none"; pw.value=""; err.textContent=""; }
    else { err.textContent="Wrong password"; pw.value=""; pw.focus(); const bx=document.getElementById("lockBox"); bx.classList.remove("shake"); void bx.offsetWidth; bx.classList.add("shake"); }
  }
  document.getElementById("pwBtn").onclick=tryUnlock;
  document.getElementById("eye").onclick=()=>{ pw.type = pw.type==="password" ? "text" : "password"; pw.focus(); };
  pw.addEventListener("keydown",e=>{ if(e.key==="Enter") tryUnlock(); });
  document.getElementById("lockBtn").onclick=()=>{ document.body.classList.add("locked"); lock.style.display="flex"; pw.focus(); };
  pw.focus();
})();
